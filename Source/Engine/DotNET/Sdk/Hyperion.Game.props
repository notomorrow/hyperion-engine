<Project>
  <PropertyGroup>
    <HyperionBinDir>$([MSBuild]::EnsureTrailingSlash('$(HyperionBinDir)'))</HyperionBinDir>
    <HyperionManagedDir Condition="'$(HyperionManagedDir)' == '' And !Exists('$(HyperionBinDir)Hyperion.NET.Runtime.dll') And Exists('$(HyperionBinDir)ref/Hyperion.NET.Runtime.dll')">$(HyperionBinDir)ref/</HyperionManagedDir>
    <HyperionManagedDir Condition="'$(HyperionManagedDir)' == ''">$(HyperionBinDir)</HyperionManagedDir>
    <HyperionManagedDir>$([MSBuild]::EnsureTrailingSlash('$(HyperionManagedDir)'))</HyperionManagedDir>
    <HyperionBaseDir Condition="'$(HyperionBaseDir)' == ''">$([System.IO.Path]::GetFullPath('$(HyperionBinDir)../../../'))</HyperionBaseDir>
    <HyperionOutputToBinDir Condition="'$(HyperionOutputToBinDir)' == ''">false</HyperionOutputToBinDir>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- must match the native hyperion library, or the apphost fails to load it -->
    <PlatformTarget Condition="'$(PlatformTarget)' == '' And $([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture) == 'Arm64'">ARM64</PlatformTarget>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HyperionOutputToBinDir)' == 'true'">
    <OutputPath>$(HyperionBinDir)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Hyperion.NET.Shared">
      <HintPath>$(HyperionManagedDir)Hyperion.NET.Shared.dll</HintPath>
    </Reference>
    <Reference Include="Hyperion.NET.Interop">
      <HintPath>$(HyperionManagedDir)Hyperion.NET.Interop.dll</HintPath>
    </Reference>
    <Reference Include="Hyperion.NET.Runtime">
      <HintPath>$(HyperionManagedDir)Hyperion.NET.Runtime.dll</HintPath>
    </Reference>

    <Analyzer Include="$(HyperionManagedDir)Hyperion.NET.Generators.dll" Condition="Exists('$(HyperionManagedDir)Hyperion.NET.Generators.dll')" />
    <Analyzer Include="$(HyperionBinDir)Hyperion.NET.Generators.dll" Condition="!Exists('$(HyperionManagedDir)Hyperion.NET.Generators.dll') And Exists('$(HyperionBinDir)Hyperion.NET.Generators.dll')" />

    <AssemblyMetadata Include="HyperionBaseDir" Value="$(HyperionBaseDir)" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)Hyperion.Web.targets" Condition="'$(HyperionWebBuild)' == 'true'" />

  <PropertyGroup>
    <HyperionProjectDir Condition="'$(HyperionProjectDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../'))</HyperionProjectDir>
    <HyperionProjectDir>$([MSBuild]::EnsureTrailingSlash('$(HyperionProjectDir)'))</HyperionProjectDir>
    <HyperionProjectContentDir Condition="'$(HyperionProjectContentDir)' == ''">$(HyperionProjectDir)</HyperionProjectContentDir>
    <HyperionProjectContentDir>$([MSBuild]::EnsureTrailingSlash('$(HyperionProjectContentDir)'))</HyperionProjectContentDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(HyperionIncludeScripts)' == 'true'">
    <Compile Include="$(HyperionProjectContentDir)Scripts/**/*.cs" Link="Scripts/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- the C# declarations CodeGen writes for a C++ game's classes, compiled in with the scripts that use them -->
  <ItemGroup Condition="'$(HyperionGameBindingsDir)' != ''">
    <Compile Include="$([MSBuild]::EnsureTrailingSlash('$(HyperionGameBindingsDir)'))**/*.cs" Link="GameBindings/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="'$(HyperionHostedEntry)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)HyperionHostedEntry.cs" Link="Hyperion/HyperionHostedEntry.cs" />

    <AssemblyAttribute Include="Hyperion.Hosting.HyperionHostedGameAttribute" Condition="'$(HyperionHostedGameClass)' != ''">
      <_Parameter1>typeof($(HyperionHostedGameClass))</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="HyperionWriteStaticLinkInputs" AfterTargets="LinkNative" Condition="'$(HyperionStaticLinkInputsFile)' != '' And '$(NativeLib)' == 'Static' And '$(HyperionWebBuild)' != 'true'">
    <ItemGroup>
      <_HyperionStaticLinkInput Include="$(NativeBinary)" />
      <_HyperionStaticLinkInput Include="@(NativeLibrary)" Condition="'%(Filename)' != 'dllmain'" />
    </ItemGroup>

    <!-- system libraries: SdkNativeLibrary on Windows, NativeSystemLibrary / NativeFramework on Unix -->
    <ItemGroup>
      <_HyperionStaticLinkSystemInput Include="@(SdkNativeLibrary)" />
      <_HyperionStaticLinkSystemInput Include="@(NativeSystemLibrary->'-l%(Identity)')" />
      <_HyperionStaticLinkSystemInput Include="@(NativeFramework->'-framework %(Identity)')" />
    </ItemGroup>

    <WriteLinesToFile File="$(HyperionStaticLinkInputsFile)" Lines="@(_HyperionStaticLinkInput->'%(FullPath)');@(_HyperionStaticLinkSystemInput)" Overwrite="true" />
  </Target>

  <Target Name="HyperionCheckBinDir" BeforeTargets="ResolveAssemblyReferences" Condition="'$(HyperionWebBuild)' != 'true'">
    <Error Condition="'$(HyperionBinDir)' == '/' Or (!Exists('$(HyperionBinDir)hyperion.dll') And !Exists('$(HyperionBinDir)libhyperion.so') And !Exists('$(HyperionBinDir)libhyperion.dylib'))"
           Text="HyperionBinDir must point at a Hyperion engine build (containing the native hyperion library); got '$(HyperionBinDir)'" />
  </Target>

  <Target Name="HyperionCopyEngineRuntime" AfterTargets="Build" Condition="'$(HyperionOutputToBinDir)' != 'true' And '$(HyperionWebBuild)' != 'true' And '$(HyperionCopyEngineRuntime)' != 'false'">
    <ItemGroup>
      <_HyperionNativeLibraries Include="$(HyperionBinDir)*.dll;$(HyperionBinDir)*.so;$(HyperionBinDir)*.dylib" Exclude="$(HyperionBinDir)Hyperion.NET.*.dll" />
      <_HyperionConfigFiles Include="$(HyperionBinDir)Config/**/*" />
    </ItemGroup>

    <Copy SourceFiles="@(_HyperionNativeLibraries)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          UseHardlinksIfPossible="true" />

    <Copy SourceFiles="@(_HyperionConfigFiles)"
          DestinationFiles="@(_HyperionConfigFiles->'$(OutDir)Config/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="HyperionWriteGlobalConfig" AfterTargets="HyperionCopyEngineRuntime" Condition="'$(HyperionWriteGlobalConfig)' == 'true' And '$(HyperionOutputToBinDir)' != 'true'">
    <PropertyGroup>
      <_HyperionConfigBaseDir>$([System.String]::Copy('$(HyperionBaseDir)').Replace('\', '/').TrimEnd('/'))</_HyperionConfigBaseDir>
      <!-- %5C rather than a literal backslash, which MSBuild turns into / on Linux and macOS, leaving invalid JSON -->
      <_HyperionConfigArgs>--basedir=%5C&quot;$(_HyperionConfigBaseDir)%5C&quot; --cooked=false --singleplayer</_HyperionConfigArgs>
      <_HyperionConfigArgs Condition="'$(HyperionContentDir)' != ''">$(_HyperionConfigArgs) --contentdir=$(HyperionContentDir)</_HyperionConfigArgs>
    </PropertyGroup>

    <WriteLinesToFile File="$(OutDir)Config/GlobalConfig.json"
                      Lines="{ &quot;App&quot;: { &quot;Name&quot;: &quot;$(AssemblyName)&quot;, &quot;Args&quot;: &quot;$(_HyperionConfigArgs)&quot; } }"
                      Overwrite="true" />
  </Target>
</Project>
