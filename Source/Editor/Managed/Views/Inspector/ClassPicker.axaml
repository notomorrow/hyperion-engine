<UserControl
    x:Class="Hyperion.Editor.Views.Inspector.ClassPicker"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Hyperion.Editor.Controls;assembly=Hyperion.Editor"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Hyperion.Editor.ViewModels;assembly=Hyperion.Editor"
    Width="260"
    x:DataType="vm:ClassPickerViewModel"
    mc:Ignorable="d">
    <DockPanel>
        <TextBox
            x:Name="PART_Search"
            Margin="0,0,0,4"
            DockPanel.Dock="Top"
            FontSize="11"
            Text="{Binding Filter, Mode=TwoWay}"
            Watermark="Search">
            <TextBox.InnerLeftContent>
                <controls:Codicon
                    Margin="8,0,6,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Brush.TextMuted}"
                    Kind="Search"
                    Size="12" />
            </TextBox.InnerLeftContent>
        </TextBox>

        <TextBlock
            Margin="8,4"
            DockPanel.Dock="Top"
            FontSize="11"
            Foreground="{DynamicResource Brush.TextMuted}"
            IsVisible="{Binding HasNoMatches}"
            Text="No matches" />

        <ListBox
            x:Name="PART_List"
            MaxHeight="320"
            Background="Transparent"
            BorderThickness="0"
            ItemsSource="{Binding Items}"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
            <ListBox.Styles>
                <Style x:DataType="vm:ClassPickerItemViewModel" Selector="ListBoxItem">
                    <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="6,4" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ClassPickerItemViewModel">
                    <Grid Margin="{Binding Indent}" ColumnDefinitions="Auto,*,Auto">
                        <controls:Codicon
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Brush.TextMuted}"
                            Kind="{Binding IconKind}"
                            Size="12" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="6,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding MatchBefore}" /><Run
                                FontWeight="Bold"
                                Foreground="{DynamicResource Brush.AccentHover}"
                                Text="{Binding MatchText}" /><Run Text="{Binding MatchAfter}" />
                        </TextBlock>
                        <controls:Codicon
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Brush.AccentHover}"
                            IsVisible="{Binding IsCurrent}"
                            Kind="Check"
                            Size="12" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
