<Window
    x:Class="Hyperion.Editor.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Hyperion.Editor.Controls;assembly=Hyperion.Editor"
    xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
    
    
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hyp="clr-namespace:Hyperion;assembly=Hyperion.Runtime"
    xmlns:inspector="clr-namespace:Hyperion.Editor.Views.Inspector;assembly=Hyperion.Editor"
    xmlns:local="clr-namespace:Hyperion.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:Hyperion.Editor.Views;assembly=Hyperion.Editor"
    xmlns:vm="clr-namespace:Hyperion.Editor.ViewModels;assembly=Hyperion.Editor"
    x:Name="Root"
    Title="Hyperion Editor"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    x:DataType="vm:MainWindowViewModel"
    x:CompileBindings="False"
    mc:Ignorable="d">

    <Window.Styles>
        <Style Selector="TabControl">
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6,6,0,0">
                        <ContentPresenter
                            Margin="6,2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextElement.Foreground="{TemplateBinding Foreground}"
                            Content="{TemplateBinding Header}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="TabItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.MenuHover}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        </Style>

        <!--  Selected tab: show a bottom border (highlight) and slightly different background  -->
        <Style Selector="TabItem:selected">
            <Setter Property="Background" Value="{DynamicResource Brush.PanelAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        </Style>

        <!--  Make the tab strip minimal height so tabs don't look flat/tall  -->
        <Style Selector="TabStrip">
            <Setter Property="Margin" Value="6,0,6,0" />
        </Style>

        <Style Selector="RadioButton.gizmo">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource Radius.Small}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="RadioButton.gizmo:checked">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentHover}" />
        </Style>

        <Style Selector="RadioButton.gizmo:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.MenuHover}" />
        </Style>

        <Style Selector="ToggleButton.gizmo">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource Radius.Small}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="ToggleButton.gizmo:checked">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentHover}" />
        </Style>

        <Style Selector="ToggleButton.gizmo:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.MenuHover}" />
        </Style>

        <Style Selector="Button.gizmo">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Transitions">
                <Transitions />
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource Radius.Small}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.gizmo:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.MenuHover}" />
        </Style>

        <Style Selector="Button.gizmo:pressed">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentHover}" />
        </Style>

        <Style Selector="DropDownButton.gizmo">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Transitions">
                <Transitions />
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource Radius.Small}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="DropDownButton.gizmo:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.MenuHover}" />
        </Style>

        <Style Selector="DropDownButton.gizmo:pressed">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentHover}" />
        </Style>

        <Style Selector="DropDownButton.gizmo-wide">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Transitions">
                <Transitions />
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource Radius.Small}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="DropDownButton.gizmo-wide:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.MenuHover}" />
        </Style>

        <Style Selector="DropDownButton.gizmo-wide:pressed">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentHover}" />
        </Style>

        <Style Selector="Border.mode-strip">
            <Setter Property="Background" Value="{DynamicResource Brush.PanelRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderLight}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
            <Setter Property="Padding" Value="7,4" />
        </Style>

        <Style Selector="Border.toolbar Button, Border.toolbar ToggleButton, Border.toolbar RadioButton">
            <Setter Property="Padding" Value="10,6" />
        </Style>

        <Style Selector="TextBlock.mode-label">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        </Style>

        <Style Selector="TextBlock.mode-target">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="2,0,4,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        </Style>

        <Style Selector="Border.mode-separator">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="2,3" />
            <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
        </Style>

        <Style Selector="TextBlock.ribbon-label">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="LetterSpacing" Value="0.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style Selector="TextBlock.status-hint">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        </Style>
    </Window.Styles>

    <Grid>
        <DockPanel Background="{DynamicResource Brush.Background}">
            <!--  Fallback in-window menu for non-macOS platforms (hidden: actions live in the toolbar)  -->
            <Menu DockPanel.Dock="Top" IsVisible="False">
                <MenuItem Header="_File">
                    <MenuItem Command="{Binding NewProject}" Header="_New Project..." IsEnabled="{Binding !IsSimulating}" />
                    <MenuItem Command="{Binding OpenProject}" Header="_Open Project..." IsEnabled="{Binding !IsSimulating}" />
                    <Separator />
                    <MenuItem Command="{Binding SaveProject}" Header="_Save Project" IsEnabled="{Binding !IsSimulating}" />
                    <MenuItem Command="{Binding SaveProjectAs}" Header="Save Project _As..." IsEnabled="{Binding !IsSimulating}" />
                    <Separator />
                    <MenuItem Command="{Binding CloseProject}" Header="Close Project" IsEnabled="{Binding !IsSimulating}" />
                    <Separator />
                    <MenuItem Command="{Binding Exit}" Header="_Exit" />
                </MenuItem>
                <MenuItem Header="_Edit" IsEnabled="{Binding !IsSimulating}">
                    <MenuItem Command="{Binding Undo}" Header="{Binding UndoHeader}" IsEnabled="{Binding CanUndo}" />
                    <MenuItem Command="{Binding Redo}" Header="{Binding RedoHeader}" IsEnabled="{Binding CanRedo}" />
                    <Separator />
                    <MenuItem Command="{Binding Copy}" Header="{Binding CopyHeader}" IsEnabled="{Binding CanCopy}" />
                    <MenuItem Command="{Binding Paste}" Header="{Binding PasteHeader}" IsEnabled="{Binding CanPaste}" />
                    <MenuItem Command="{Binding Delete}" Header="{Binding DeleteHeader}" />
                    <Separator />
                    <MenuItem Command="{Binding SelectAll}" Header="Select _All" />
                    <MenuItem Header="Select All in Viewport" />
                    <MenuItem Header="Select None" />
                </MenuItem>
                <MenuItem Header="_Layout">
                    <MenuItem Header="_Reset Layout" Click="OnResetLayoutClick" ToolTip.Tip="Restore the default dock layout" />
                </MenuItem>
                <MenuItem Header="_Build" IsEnabled="{Binding !IsSimulating}">
                  <MenuItem Command="{Binding BuildReflectionProbes}" Header="Reflection Probes" />
                  <MenuItem Command="{Binding BuildIrradianceProbes}" Header="Irradiance Probes" />
                  <Separator />
                  <MenuItem Command="{Binding BuildLightmaps}" Header="Lightmaps" />
                  <Separator />
                  <MenuItem Command="{Binding BuildBentNormals}" Header="Bent Normals" />
                  <Separator />
                  <MenuItem Command="{Binding RebuildMeshBVHs}" Header="Rebuild Mesh BVHs" />
                  <Separator />
                  <MenuItem Command="{Binding CookGameContent}" Header="Cook Game Content" />
                </MenuItem>
            </Menu>

            <Border Classes="panel-header toolbar" DockPanel.Dock="Top" Padding="8,4">
                <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,*,Auto">
                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="ribbon-label" Text="PROJECT" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="gizmo" Command="{Binding NewProject}" IsEnabled="{Binding !IsSimulating}" ToolTip.Tip="New Project">
                            <controls:Codicon Kind="File" Size="16" />
                        </Button>
                        <Button Classes="gizmo" Command="{Binding OpenProject}" IsEnabled="{Binding !IsSimulating}" ToolTip.Tip="Open">
                            <controls:Codicon Kind="FolderOpened" Size="16" />
                        </Button>
                        <Button Classes="gizmo" Command="{Binding SaveProject}" IsEnabled="{Binding !IsSimulating}" ToolTip.Tip="Save">
                            <controls:Codicon Kind="Save" Size="16" />
                        </Button>
                            </StackPanel>
                        </StackPanel>

                        <Border Classes="mode-separator" />

                        <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="ribbon-label" Text="EDIT" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="gizmo" Command="{Binding Undo}" ToolTip.Tip="{Binding UndoHeader}" IsEnabled="{Binding CanUndo}">
                            <controls:Codicon Kind="Discard" Size="16" />
                        </Button>
                        <Button Classes="gizmo" Command="{Binding Redo}" ToolTip.Tip="{Binding RedoHeader}" IsEnabled="{Binding CanRedo}">
                            <controls:Codicon Kind="Redo" Size="16" />
                        </Button>
                        <Button Classes="gizmo" Command="{Binding Copy}" ToolTip.Tip="{Binding CopyHeader}" IsEnabled="{Binding CanCopy}">
                            <controls:Codicon Kind="Copy" Size="16" />
                        </Button>
                        <Button Classes="gizmo" Command="{Binding Paste}" ToolTip.Tip="{Binding PasteHeader}" IsEnabled="{Binding CanPaste}">
                            <controls:Codicon Kind="Clippy" Size="16" />
                        </Button>
                        <DropDownButton
                            Classes="gizmo-wide"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Select">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <controls:Codicon Kind="Select" Size="16" VerticalAlignment="Center" />
                                <controls:Codicon Kind="ChevronDown" Size="10" VerticalAlignment="Center" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel MinWidth="150">
                                        <MenuItem Command="{Binding SelectAll}" Header="Select All" />
                                        <MenuItem Header="Select All in Viewport" />
                                        <MenuItem Header="Select None" />
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                            </StackPanel>
                        </StackPanel>

                        <Border Classes="mode-separator" />

                        <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="ribbon-label" Text="LAYERS" />
                        <DropDownButton
                            x:Name="ActiveLayersDropDown"
                            Classes="gizmo"
                            ToolTip.Tip="Active Layers (Visibility)">
                            <controls:Codicon Kind="Layers" Size="16" />
                            <DropDownButton.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel MinWidth="150">
                                        <ItemsControl ItemsSource="{Binding ActiveLayerToggles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:LayerToggleViewModel">
                                                    <CheckBox
                                                        Classes="layers-toggle"
                                                        Content="{Binding Name}"
                                                        IsChecked="{Binding IsActive, Mode=TwoWay}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Separator />

                                        <MenuItem
                                            Command="{Binding AddNewLayerCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                            Header="Add New Layer..." />
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        </StackPanel>

                        <Border Classes="mode-separator" />

                        <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="ribbon-label" Text="SWATCH" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <DropDownButton
                                    x:Name="SwatchDropDown"
                                    Classes="gizmo-wide"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Active Swatch">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <controls:Codicon Kind="Paintbrush" Size="16" VerticalAlignment="Center" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Text="{Binding ActiveSwatchName, FallbackValue='Default'}" />
                                    </StackPanel>
                                    <DropDownButton.Flyout>
                                        <Flyout Placement="Bottom">
                                            <StackPanel MinWidth="150">
                                                <ItemsControl ItemsSource="{Binding Swatches}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <MenuItem
                                                                Command="{Binding SetActiveSwatchCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                CommandParameter="{Binding}"
                                                                Header="{Binding}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Separator />
                                                <MenuItem
                                                    Command="{Binding AddNewSwatchCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                    Header="New Swatch..." />
                                            </StackPanel>
                                        </Flyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>

                                <ToggleButton
                                    x:Name="SwatchOverrideModeToggle"
                                    Height="30"
                                    Padding="8,4"
                                    Classes="panel-toggle"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding Inspector.SwatchOverrideMode, Mode=TwoWay}"
                                    IsVisible="{Binding Inspector.CanUseSwatchOverrides}"
                                    ToolTip.Tip="When this toggle button is active, edits will apply as OVERRIDES for the active swatch. Otherwise edits will apply on base + active.">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <controls:Codicon Kind="GitBranch" Size="12" VerticalAlignment="Center" />
                                        <Panel>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="9"
                                                IsVisible="{Binding Inspector.SwatchOverrideMode}"
                                                Text="Override Edits: ON" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="9"
                                                IsVisible="{Binding !Inspector.SwatchOverrideMode}"
                                                Text="Override Edits: OFF" />
                                        </Panel>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                        </StackPanel>

                        <Border Classes="mode-separator" />
                        
                        <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="ribbon-label" Text="BAKE" />
                            <DropDownButton
                                Classes="gizmo-wide"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Bake"
                                IsEnabled="{Binding !IsSimulating}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <controls:Codicon Kind="Lightbulb" Size="16" VerticalAlignment="Center" />
                                    <controls:Codicon Kind="ChevronDown" Size="10" VerticalAlignment="Center" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <Flyout Placement="Bottom">
                                        <StackPanel MinWidth="150">
                                            <MenuItem Command="{Binding BuildReflectionProbes}" Header="Reflection Probes" />
                                            <MenuItem Command="{Binding BuildIrradianceProbes}" Header="Irradiance Probes" />
                                            <Separator />
                                            <MenuItem Command="{Binding BuildLightmaps}" Header="Lightmaps" />
                                            <Separator />
                                            <MenuItem Command="{Binding BuildBentNormals}" Header="Bent Normals" />
                                        </StackPanel>
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>

                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="ribbon-label" Text="TRANSFORM" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                        <ToggleButton
                            x:Name="TransformModeTranslate"
                            Classes="gizmo"
                            Command="{Binding SelectTransformModeTranslate}"
                            IsChecked="{Binding IsTransformModeTranslateActive, Mode=OneWay}"
                            IsEnabled="{Binding CanSelectTransformModeTranslate}"
                            ToolTip.Tip="Translate">
                            <controls:Codicon Kind="Move" Size="16" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="TransformModeRotate"
                            Classes="gizmo"
                            Command="{Binding SelectTransformModeRotate}"
                            IsChecked="{Binding IsTransformModeRotateActive, Mode=OneWay}"
                            IsEnabled="{Binding CanSelectTransformModeRotate}"
                            ToolTip.Tip="Rotate">
                            <controls:Codicon Kind="Refresh" Size="16" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="TransformModeScale"
                            Classes="gizmo"
                            Command="{Binding SelectTransformModeScale}"
                            IsChecked="{Binding IsTransformModeScaleActive, Mode=OneWay}"
                            IsEnabled="{Binding CanSelectTransformModeScale}"
                            ToolTip.Tip="Scale">
                            <controls:Codicon Kind="ScreenFull" Size="16" />
                        </ToggleButton>
                            </StackPanel>
                        </StackPanel>

                        <Border Classes="mode-separator" />

                        <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="ribbon-label" Text="EDIT" />
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ToggleButton
                            x:Name="SnapToGridToggle"
                            Classes="gizmo"
                            Command="{Binding ToggleSnapToGrid}"
                            IsChecked="{Binding IsSnapToGridEnabled, Mode=OneWay}"
                            ToolTip.Tip="Snap Movement To Grid (1 Unit)">
                            <controls:Codicon Kind="Magnet" Size="16" />
                        </ToggleButton>

                        <Border Classes="mode-separator" />

                        <ToggleButton
                            x:Name="MeshEditModeToggle"
                            Classes="gizmo"
                            Command="{Binding ToggleMeshEditMode}"
                            IsChecked="{Binding IsMeshEditModeEnabled, Mode=OneWay}"
                            IsEnabled="{Binding CanEnableMeshEditMode}"
                            ToolTip.Tip="{Binding MeshEditModeTooltip}">
                            <controls:Codicon Kind="MeshEditMode" Size="16" />
                        </ToggleButton>

                        <Border
                            Classes="mode-strip"
                            IsVisible="{Binding IsMeshEditModeEnabled}">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock
                                    Classes="mode-target"
                                    VerticalAlignment="Center"
                                    MaxWidth="160"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{Binding MeshEditTargetName}"
                                    ToolTip.Tip="{Binding MeshEditTargetName}" />

                                <Border Classes="mode-separator" />

                                <ToggleButton
                                    x:Name="MeshEditFaceModeTriangle"
                                    Classes="gizmo"
                                    Command="{Binding SelectMeshEditFaceTriangle}"
                                    IsChecked="{Binding !IsMeshEditFaceModeQuad, Mode=OneWay}"
                                    ToolTip.Tip="Edit triangle faces">
                                    <controls:Codicon Kind="TriangleRight" Size="16" />
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="MeshEditFaceModeQuad"
                                    Classes="gizmo"
                                    Command="{Binding SelectMeshEditFaceQuad}"
                                    IsChecked="{Binding IsMeshEditFaceModeQuad, Mode=OneWay}"
                                    ToolTip.Tip="Edit as quads">
                                    <controls:Codicon Kind="PrimitiveSquare" Size="16" />
                                </ToggleButton>

                                <Border Classes="mode-separator" />

                                <ToggleButton
                                    x:Name="MeshEditAlignToNormal"
                                    Classes="gizmo"
                                    Command="{Binding ToggleMeshEditAlignToNormal}"
                                    IsChecked="{Binding IsMeshEditAlignToNormal, Mode=OneWay}"
                                    ToolTip.Tip="Align to normal">
                                    <controls:Codicon Kind="AlignToNormal" Size="16" />
                                </ToggleButton>

                                <Border Classes="mode-separator" />

                                <Button
                                    x:Name="SaveMeshEditsButton"
                                    Classes="gizmo"
                                    Command="{Binding SaveMeshEdits}"
                                    ToolTip.Tip="Save Edits">
                                    <controls:Codicon Kind="Check" Size="16" />
                                </Button>
                                <Button
                                    x:Name="DiscardMeshEditsButton"
                                    Classes="gizmo"
                                    Command="{Binding DiscardMeshEdits}"
                                    IsEnabled="{Binding HasPendingMeshEdits}"
                                    ToolTip.Tip="Discard Edits">
                                    <controls:Codicon Kind="Close" Size="16" />
                                </Button>
                            </StackPanel>
                        </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="ribbon-label" Text="PLAY" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button
                            Command="{Binding SetGameModePlaying}"
                            IsVisible="{Binding CanSetGameModePlaying}"
                            ToolTip.Tip="Play"
                            Classes="Play">
                            <controls:Codicon Kind="Play" Size="16" Foreground="White" />
                        </Button>
                        <Button
                            Command="{Binding SetGameModePaused}"
                            IsVisible="{Binding CanSetGameModePaused}"
                            ToolTip.Tip="Pause">
                            <controls:Codicon Kind="DebugPause" Size="16" />
                        </Button>
                        <Button
                            Command="{Binding SetGameModeStopped}"
                            IsVisible="{Binding CanSetGameModeStopped}"
                            ToolTip.Tip="Stop">
                            <controls:Codicon Kind="DebugStop" Size="16" />
                        </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid RowDefinitions="*, Auto">
                <!--  Dockable workspace  -->
                <DockControl
                    x:Name="DockControl"
                    Grid.Row="0"
                    InitializeLayout="True"
                    InitializeFactory="True">
                    <DockControl.Factory>
                        <Factory HideToolsOnClose="True" HideDocumentsOnClose="True" />
                    </DockControl.Factory>

                    <RootDock x:Name="DockRoot" Id="Root" IsCollapsable="False" DefaultDockable="{Binding #MainLayout}">

                        <ProportionalDock x:Name="MainLayout" Id="MainLayout" Orientation="Horizontal">

                            <!--  Left column: Scene hierarchy + Inspector  -->
                            <ProportionalDock x:Name="Left" Id="Left" Orientation="Vertical" Proportion="0.25">

                                <ToolDock x:Name="HierarchyPane" Id="HierarchyPane" Alignment="Left" ActiveDockable="SceneHierarchyTool">
                                    <Tool x:Name="SceneHierarchyTool" Id="SceneHierarchy" Title="Scene">
                                        <ContentControl DataContext="{Binding Source={x:Static vm:MainWindowViewModel.Instance}}">
                                            <Grid RowDefinitions="Auto, *">
                                                <Border Grid.Row="0" Classes="panel-header">
                                                    <Grid VerticalAlignment="Center" ColumnDefinitions="*,Auto">
                                                        <DropDownButton
                                                            x:Name="SceneDropDown"
                                                            Grid.Column="0"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Background="Transparent"
                                                            BorderThickness="0">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <controls:Codicon Kind="ListTree" Size="14" Foreground="{StaticResource Brush.TextMuted}" />
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    Classes="header"
                                                                    Text="{Binding ActiveScene.Name, FallbackValue='No Active Scene'}" />
                                                            </StackPanel>
                                                            <DropDownButton.Flyout>
                                                                <Flyout Placement="Bottom">
                                                                    <StackPanel MinWidth="150">
                                                                        <ItemsControl ItemsSource="{Binding Scenes}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:SceneViewModel">
                                                                                    <MenuItem
                                                                                        Command="{Binding SetActiveSceneCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                                        CommandParameter="{Binding}"
                                                                                        Header="{Binding Name}" />
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>

                                                                        <Separator />
                                                                        <MenuItem
                                                                            Command="{Binding AddNewSceneCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                            Header="Add New Scene..."
                                                                            IsEnabled="{Binding !IsSimulating, Source={x:Static vm:MainWindowViewModel.Instance}}" />
                                                                    </StackPanel>
                                                                </Flyout>
                                                            </DropDownButton.Flyout>
                                                        </DropDownButton>
                                                        <Button
                                                            Grid.Column="1"
                                                            Margin="0,0,4,0"
                                                            Padding="8,2"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            IsEnabled="{Binding !IsSimulating}"
                                                            ToolTip.Tip="Add new node to the active scene...">
                                                            <controls:Codicon Kind="Add" Size="16" />
                                                            <Button.Flyout>
                                                                <MenuFlyout>
                                                                    <MenuItem
                                                                        Margin="0,2"
                                                                        Padding="8,4"
                                                                        HorizontalAlignment="Center"
                                                                        FontSize="12"
                                                                        Foreground="#808080"
                                                                        Header="Node"
                                                                        IsEnabled="False" />
                                                                    <MenuItem Command="{Binding AddEmptyNode}" Header="Base Node" />
                                                                    <Separator />
                                                                    <MenuItem Command="{Binding AddEntity}" Header="Entity" />
                                                                    <MenuItem Command="{Binding AddCamera}" Header="Camera" />
                                                                    <Separator />
                                                                    <MenuItem
                                                                        Margin="0,2"
                                                                        Padding="8,4"
                                                                        HorizontalAlignment="Center"
                                                                        FontSize="12"
                                                                        Foreground="#808080"
                                                                        Header="Rendering"
                                                                        IsEnabled="False" />
                                                                    <MenuItem Command="{Binding AddInstance}" Header="Instanced Mesh" IsEnabled="{Binding CanAddInstance}" />
                                                                    <Separator />
                                                                    <MenuItem
                                                                        Margin="0,2"
                                                                        Padding="8,4"
                                                                        HorizontalAlignment="Center"
                                                                        FontSize="12"
                                                                        Foreground="#808080"
                                                                        Header="2D"
                                                                        IsEnabled="False" />
                                                                    <MenuItem Command="{Binding AddSprite}" Header="Sprite" />
                                                                    <MenuItem Command="{Binding AddTextSprite}" Header="Text Sprite" />
                                                                    <Separator />
                                                                    <MenuItem
                                                                        Margin="0,2"
                                                                        Padding="8,4"
                                                                        HorizontalAlignment="Center"
                                                                        FontSize="12"
                                                                        Foreground="#808080"
                                                                        Header="Lighting"
                                                                        IsEnabled="False" />
                                                                    <MenuItem Command="{Binding AddDirectionalLight}" Header="Directional Light" />
                                                                    <MenuItem Command="{Binding AddPointLight}" Header="Point Light" />
                                                                    <MenuItem Command="{Binding AddSpotLight}" Header="Spot Light" />
                                                                    <MenuItem Command="{Binding AddAreaRectLight}" Header="Rectangular Area Light" />
                                                                    <Separator />
                                                                    <MenuItem Command="{Binding AddReflectionProbe}" Header="Reflection Probe" />
                                                                    <MenuItem Command="{Binding AddIrradianceProbe}" Header="Irradiance Probe" />
                                                                    <MenuItem Command="{Binding AddLightmapVolume}" Header="Lightmap Volume" />
                                                                    <Separator />
                                                                    <MenuItem
                                                                        Margin="0,2"
                                                                        Padding="8,4"
                                                                        HorizontalAlignment="Center"
                                                                        FontSize="12"
                                                                        Foreground="#808080"
                                                                        Header="FX"
                                                                        IsEnabled="False" />
                                                                    <MenuItem Command="{Binding AddParticleVolume}" Header="Particle Volume" />
                                                                    <MenuItem Command="{Binding AddFogVolume}" Header="Fog Volume" />

                                                                    <Separator />
                                                                    <MenuItem
                                                                        Margin="0,2"
                                                                        Padding="8,4"
                                                                        HorizontalAlignment="Center"
                                                                        FontSize="12"
                                                                        Foreground="#808080"
                                                                        Header="Shapes"
                                                                        IsEnabled="False" />

                                                                    <MenuItem Command="{Binding AddPlane}" Header="Plane" />
                                                                    <MenuItem Command="{Binding AddCube}" Header="Cube" />
                                                                    <MenuItem Command="{Binding AddNormalizedCubeSphereCommand}" Header="Normalized Cube Sphere" />
                                                                    <MenuItem Command="{Binding AddCylinder}" Header="Cylinder" />
                                                                    <Separator />
                                                                    <MenuItem Header="Templates">
                                                                        <MenuItem Command="{Binding AddPlayerEntity}" Header="Player Entity" />
                                                                    </MenuItem>

                                                                </MenuFlyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                    </Grid>
                                                </Border>

                                                <TreeView
                                                    x:Name="SceneHierarchyTreeView"
                                                    Grid.Row="1"
                                                    ItemsSource="{Binding SceneHierarchy.RootNodes}"
                                                    SelectedItem="{Binding SceneHierarchy.SelectedNode}"
                                                    SelectionMode="Multiple">
                                                    <TreeView.ItemContainerTheme>
                                                        <ControlTheme
                                                            x:DataType="vm:NodeViewModel"
                                                            BasedOn="{StaticResource {x:Type TreeViewItem}}"
                                                            TargetType="TreeViewItem">
                                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                                        </ControlTheme>
                                                    </TreeView.ItemContainerTheme>
                                                    <TreeView.ItemTemplate>
                                                        <TreeDataTemplate x:DataType="vm:NodeViewModel" ItemsSource="{Binding Children}">
                                                            <Grid Background="Transparent" HorizontalAlignment="Stretch">
                                                                <!--  Drop-target highlight: sits behind the label, shown during drag-over  -->
                                                                <Border
                                                                    Background="{DynamicResource Brush.Accent}"
                                                                    CornerRadius="3"
                                                                    IsVisible="{Binding IsDropTarget}"
                                                                    Opacity="0.35" />
                                                                <StackPanel Margin="2,2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Accent}" IsVisible="{Binding IsDirty}" VerticalAlignment="Center" />
                                                                    <controls:Codicon Kind="{Binding IconKind}" Size="14" Opacity="0.7" VerticalAlignment="Center" />
                                                                    <TextBlock FontStyle="{Binding NameFontStyle}" IsVisible="{Binding !IsEditingName}" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                                                    <TextBox
                                                                        Name="NodeRenameTextBox"
                                                                        MinWidth="80"
                                                                        Padding="2,0"
                                                                        IsVisible="{Binding IsEditingName}"
                                                                        Text="{Binding EditingName, Mode=TwoWay}"
                                                                        VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <Grid.ContextMenu>
                                                                    <ContextMenu Opened="OnNodeContextMenuOpened">
                                                                        <MenuItem Command="{Binding Copy, Source={x:Static vm:MainWindowViewModel.Instance}}" Header="{Binding CopyHeader, Source={x:Static vm:MainWindowViewModel.Instance}}" IsEnabled="{Binding !IsSimulating, Source={x:Static vm:MainWindowViewModel.Instance}}" />
                                                                        <MenuItem Command="{Binding Paste, Source={x:Static vm:MainWindowViewModel.Instance}}" Header="{Binding PasteHeader, Source={x:Static vm:MainWindowViewModel.Instance}}" IsEnabled="{Binding !IsSimulating, Source={x:Static vm:MainWindowViewModel.Instance}}" />
                                                                        <Separator />
                                                                        <MenuItem Click="OnRenameNodeMenuItemClick" Header="Rename" IsEnabled="{Binding !IsSimulating, Source={x:Static vm:MainWindowViewModel.Instance}}" />
                                                                        <MenuItem Command="{Binding TeleportToNode, Source={x:Static vm:MainWindowViewModel.Instance}}" CommandParameter="{Binding Name}" Header="Teleport to" IsEnabled="{Binding !IsSimulating, Source={x:Static vm:MainWindowViewModel.Instance}}" />
                                                                        <MenuItem Click="OnMoveToGrandparentMenuItemClick" Header="{Binding MoveToGrandparentHeader}" IsVisible="{Binding CanMoveToGrandparent}" IsEnabled="{Binding !IsSimulating, Source={x:Static vm:MainWindowViewModel.Instance}}" />
                                                                        <Separator IsVisible="{Binding HasActions}" />
                                                                        <MenuItem Header="Actions" IsVisible="{Binding HasActions}" IsEnabled="{Binding !IsSimulating, Source={x:Static vm:MainWindowViewModel.Instance}}" ItemsSource="{Binding Actions}">
                                                                            <MenuItem.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:InspectorActionViewModel">
                                                                                    <MenuItem Command="{Binding ExecuteActionCommand}" Header="{Binding Label}" IsEnabled="{Binding IsEnabled}" />
                                                                                </DataTemplate>
                                                                            </MenuItem.ItemTemplate>
                                                                        </MenuItem>
                                                                        <Separator />
                                                                        <MenuItem Command="{Binding DeleteNode, Source={x:Static vm:MainWindowViewModel.Instance}}" Header="{Binding DeleteHeader, Source={x:Static vm:MainWindowViewModel.Instance}}" IsEnabled="{Binding !IsSimulating, Source={x:Static vm:MainWindowViewModel.Instance}}" />
                                                                    </ContextMenu>
                                                                </Grid.ContextMenu>
                                                            </Grid>
                                                        </TreeDataTemplate>
                                                    </TreeView.ItemTemplate>
                                                </TreeView>
                                            </Grid>
                                        </ContentControl>
                                    </Tool>
                                </ToolDock>

                                <ProportionalDockSplitter x:Name="LeftSplitter" Id="LeftSplitter" />

                                <ToolDock x:Name="InspectorPane" Id="InspectorPane" Alignment="Bottom" ActiveDockable="InspectorTool">
                                    <Tool x:Name="InspectorTool" Id="Inspector" Title="Inspector">
                                        <ContentControl DataContext="{Binding Source={x:Static vm:MainWindowViewModel.Instance}}">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel Spacing="8">
                                                    <Grid
                                                        Margin="0"
                                                        DataContext="{Binding Inspector}"
                                                        IsVisible="{Binding IsEntity}"
                                                        RowDefinitions="Auto, Auto, Auto">

                                                        <Border Grid.Row="0" Classes="panel-header">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <ToggleButton
                                                                    Grid.Column="0"
                                                                    Classes="section-toggle"
                                                                    IsChecked="{Binding ComponentsSection.IsExpanded, Mode=TwoWay}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                        <controls:Codicon Kind="{Binding ComponentsSection.ChevronKind}" Size="10" Margin="2,2,0,0" />
                                                                        <TextBlock VerticalAlignment="Center" Classes="header" Text="Components" />
                                                                    </StackPanel>
                                                                </ToggleButton>

                                                                <Button
                                                                    Grid.Column="1"
                                                                    Margin="0,0,4,0"
                                                                    Padding="8,2"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center"
                                                                    Content="Add"
                                                                    IsEnabled="{Binding HasAddableComponents}">
                                                                    <Button.Flyout>
                                                                        <MenuFlyout ItemsSource="{Binding AddableComponents}">
                                                                            <MenuFlyout.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:AddComponentOptionViewModel">
                                                                                    <MenuItem
                                                                                        Command="{Binding Inspector.AddComponentCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                                        CommandParameter="{Binding}"
                                                                                        Header="{Binding Label}"
                                                                                        IsEnabled="{Binding IsEnabled}" />
                                                                                </DataTemplate>
                                                                            </MenuFlyout.ItemTemplate>
                                                                        </MenuFlyout>
                                                                    </Button.Flyout>
                                                                </Button>
                                                            </Grid>
                                                        </Border>

                                                        <ItemsControl
                                                            Grid.Row="1"
                                                            Margin="12,6"
                                                            ItemsSource="{Binding Components}">
                                                            <ItemsControl.IsVisible>
                                                                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                                                    <Binding Path="HasComponents" />
                                                                    <Binding Path="ComponentsSection.IsExpanded" />
                                                                </MultiBinding>
                                                            </ItemsControl.IsVisible>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:InspectorComponentViewModelBase">
                                                                    <Border
                                                                        Margin="0,0,0,6"
                                                                        Padding="10"
                                                                        Background="{DynamicResource Brush.PanelRaised}"
                                                                        BorderBrush="{DynamicResource Brush.BorderLight}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="{DynamicResource Radius.Medium}">
                                                                        <StackPanel Spacing="6">
                                                                            <Grid ColumnDefinitions="*,Auto">
                                                                                <TextBlock Grid.Column="0" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Text="{Binding Label}" />
                                                                                <Button
                                                                                    Grid.Column="1"
                                                                                    Padding="4,2"
                                                                                    ToolTip.Tip="Remove component"
                                                                                    Command="{Binding Inspector.RemoveComponentCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                                    CommandParameter="{Binding}">
                                                                                    <controls:Codicon Kind="Trash" Size="14" />
                                                                                </Button>
                                                                            </Grid>

                                                                            <!--  Component-level scalar properties  -->
                                                                            <inspector:InspectorPropertyItemsControl
                                                                                IsVisible="{Binding HasProperties}"
                                                                                ItemsSource="{Binding Properties}" />

                                                                            <!--  Sub-object groups (Mesh, Material, etc.)  -->
                                                                            <ItemsControl
                                                                                IsVisible="{Binding HasSubObjects}"
                                                                                ItemsSource="{Binding SubObjects}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="vm:ComponentSubObjectViewModel">
                                                                                        <StackPanel Margin="0,4,0,0" Spacing="2">
                                                                                            <TextBlock FontWeight="SemiBold" Margin="0,2,0,2" Text="{Binding Label}" />
                                                                                            <inspector:InspectorPropertyItemsControl
                                                                                                IsVisible="{Binding HasProperties}"
                                                                                                ItemsSource="{Binding Properties}" />
                                                                                        </StackPanel>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>

                                                    <Grid
                                                        Margin="0"
                                                        DataContext="{Binding Inspector}"
                                                        IsVisible="{Binding IsEntity}"
                                                        RowDefinitions="Auto, Auto, Auto">

                                                        <Border Grid.Row="0" Classes="panel-header">
                                                            <ToggleButton
                                                                Classes="section-toggle"
                                                                IsChecked="{Binding TagsSection.IsExpanded, Mode=TwoWay}">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <controls:Codicon Kind="{Binding TagsSection.ChevronKind}" Size="10" Margin="2,2,0,0" />
                                                                    <TextBlock VerticalAlignment="Center" Classes="header" Text="Tags" />
                                                                </StackPanel>
                                                            </ToggleButton>
                                                        </Border>

                                                        <Grid
                                                            Grid.Row="1"
                                                            Margin="12,6,12,6"
                                                            ColumnDefinitions="*,Auto"
                                                            IsVisible="{Binding TagsSection.IsExpanded}">
                                                            <ComboBox
                                                                Grid.Column="0"
                                                                Margin="0,0,6,0"
                                                                HorizontalAlignment="Stretch"
                                                                PlaceholderText="Add tag"
                                                                IsEnabled="{Binding EntityTags.HasAvailableTags}"
                                                                ItemsSource="{Binding EntityTags.AvailableTags}"
                                                                SelectedItem="{Binding EntityTags.SelectedAvailableTag, Mode=TwoWay}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:EntityTagOptionViewModel">
                                                                        <TextBlock Text="{Binding Name}" />
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <Button
                                                                Grid.Column="1"
                                                                Padding="8,2"
                                                                Content="Add"
                                                                Command="{Binding EntityTags.AddTagCommand}"
                                                                CommandParameter="{Binding EntityTags.SelectedAvailableTag}" />
                                                        </Grid>

                                                        <ItemsControl
                                                            Grid.Row="2"
                                                            Margin="12,6,12,6"
                                                            ItemsSource="{Binding EntityTags.Tags}">
                                                            <ItemsControl.IsVisible>
                                                                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                                                    <Binding Path="EntityTags.HasTags" />
                                                                    <Binding Path="TagsSection.IsExpanded" />
                                                                </MultiBinding>
                                                            </ItemsControl.IsVisible>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:EntityTagItemViewModel">
                                                                    <Border
                                                                        Margin="0,0,0,6"
                                                                        Padding="8,4"
                                                                        Background="{DynamicResource Brush.PanelRaised}"
                                                                        BorderBrush="{DynamicResource Brush.BorderLight}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="{DynamicResource Radius.Medium}">
                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                            <TextBlock Grid.Column="0" FontSize="12" VerticalAlignment="Center" Text="{Binding Name}" />
                                                                            <Button
                                                                                Grid.Column="1"
                                                                                Padding="4,2"
                                                                                ToolTip.Tip="Remove tag"
                                                                                Command="{Binding Inspector.EntityTags.RemoveTagCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                                CommandParameter="{Binding}">
                                                                                <controls:Codicon Kind="Trash" Size="14" />
                                                                            </Button>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>

                                                    <Grid
                                                        Margin="0"
                                                        DataContext="{Binding Inspector}"
                                                        IsVisible="{Binding IsEntity}"
                                                        RowDefinitions="Auto, Auto, Auto">

                                                        <Border Grid.Row="0" Classes="panel-header">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <ToggleButton
                                                                    Grid.Column="0"
                                                                    Classes="section-toggle"
                                                                    IsChecked="{Binding LayersSection.IsExpanded, Mode=TwoWay}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                        <controls:Codicon Kind="{Binding LayersSection.ChevronKind}" Size="10" Margin="2,2,0,0" />
                                                                        <TextBlock VerticalAlignment="Center" Classes="header" Text="Layers" />
                                                                    </StackPanel>
                                                                </ToggleButton>

                                                                <Button
                                                                    Grid.Column="1"
                                                                    Margin="0,0,4,0"
                                                                    Padding="8,2"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center"
                                                                    Content="Add">
                                                                    <Button.Flyout>
                                                                        <Flyout Placement="Bottom">
                                                                            <StackPanel MinWidth="150">
                                                                                <ItemsControl ItemsSource="{Binding EntityLayers.AvailableLayers}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate x:DataType="vm:EntityLayerOptionViewModel">
                                                                                            <MenuItem
                                                                                                Command="{Binding Inspector.EntityLayers.AddLayerCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                                                CommandParameter="{Binding}"
                                                                                                Header="{Binding Name}" />
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>

                                                                                <Separator />
                                                                                <MenuItem
                                                                                    Command="{Binding Inspector.EntityLayers.CreateNewLayerCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                                    Header="New Layer..." />
                                                                            </StackPanel>
                                                                        </Flyout>
                                                                    </Button.Flyout>
                                                                </Button>
                                                            </Grid>
                                                        </Border>

                                                        <ItemsControl
                                                            Grid.Row="1"
                                                            Margin="12,6,12,6"
                                                            ItemsSource="{Binding EntityLayers.Layers}">
                                                            <ItemsControl.IsVisible>
                                                                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                                                    <Binding Path="EntityLayers.HasLayers" />
                                                                    <Binding Path="LayersSection.IsExpanded" />
                                                                </MultiBinding>
                                                            </ItemsControl.IsVisible>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:EntityLayerItemViewModel">
                                                                    <Border
                                                                        Margin="0,0,0,6"
                                                                        Padding="8,4"
                                                                        Background="{DynamicResource Brush.PanelRaised}"
                                                                        BorderBrush="{DynamicResource Brush.BorderLight}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="{DynamicResource Radius.Medium}">
                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                            <TextBlock Grid.Column="0" FontSize="12" VerticalAlignment="Center" Text="{Binding Name}" />
                                                                            <Button
                                                                                Grid.Column="1"
                                                                                Padding="4,2"
                                                                                ToolTip.Tip="Remove from layer"
                                                                                Command="{Binding Inspector.EntityLayers.RemoveLayerCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                                CommandParameter="{Binding}">
                                                                                <controls:Codicon Kind="Trash" Size="14" />
                                                                            </Button>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>

                                                    <Grid
                                                        Margin="0"
                                                        IsVisible="{Binding Inspector.HasAttachedScript}"
                                                        RowDefinitions="Auto, Auto">
                                                        <Border Grid.Row="0" Classes="panel-header">
                                                            <ToggleButton
                                                                Classes="section-toggle"
                                                                IsChecked="{Binding Inspector.ScriptSection.IsExpanded, Mode=TwoWay}">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <controls:Codicon Kind="{Binding Inspector.ScriptSection.ChevronKind}" Size="10" Margin="2,2,0,0" />
                                                                    <TextBlock VerticalAlignment="Center" Classes="header" Text="Script" />
                                                                </StackPanel>
                                                            </ToggleButton>
                                                        </Border>

                                                        <StackPanel Grid.Row="1" IsVisible="{Binding Inspector.ScriptSection.IsExpanded}">
                                                            <Grid
                                                                DataContext="{Binding Inspector.AttachedScript}"
                                                                ColumnDefinitions="72,*"
                                                                Margin="12,6,12,4">
                                                            <Border
                                                                Width="64"
                                                                Height="64"
                                                                Margin="0,0,8,0"
                                                                VerticalAlignment="Top"
                                                                Background="{DynamicResource Brush.PanelRaised}"
                                                                BorderBrush="{DynamicResource Brush.BorderLight}"
                                                                BorderThickness="1"
                                                                CornerRadius="{DynamicResource Radius.Medium}">
                                                                <TextBlock
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="22"
                                                                    Opacity="0.3"
                                                                    Text="☐" />
                                                            </Border>

                                                            <StackPanel Grid.Column="1" Spacing="4">
                                                                <TextBlock
                                                                    FontSize="12"
                                                                    FontWeight="SemiBold"
                                                                    Text="{Binding ScriptDisplay}" />

                                                                <Border
                                                                    Background="{DynamicResource Brush.PanelRaised}"
                                                                    BorderBrush="{DynamicResource Brush.BorderLight}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="{DynamicResource Radius.Small}"
                                                                    Padding="6,5">
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        Text="{Binding AssetPathDisplay}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                </Border>

                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <Button
                                                                        Padding="8,2"
                                                                        FontSize="11"
                                                                        Command="{Binding SelectCommand}"
                                                                        Content="Swap"
                                                                        IsEnabled="{Binding CanSelectFromContentBrowser}"
                                                                        ToolTip.Tip="Assign to the currently selected asset in the Assets drawer" />
                                                                    <Button
                                                                        Padding="8,2"
                                                                        FontSize="11"
                                                                        Command="{Binding ClearCommand}"
                                                                        Content="Clear"
                                                                        IsEnabled="{Binding HasScript}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid
                                                        Margin="0"
                                                        IsVisible="{Binding Inspector.HasActions}"
                                                        RowDefinitions="Auto, Auto">
                                                        <Border Grid.Row="0" Classes="panel-header">
                                                            <ToggleButton
                                                                Classes="section-toggle"
                                                                IsChecked="{Binding Inspector.ActionsSection.IsExpanded, Mode=TwoWay}">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <controls:Codicon Kind="{Binding Inspector.ActionsSection.ChevronKind}" Size="10" Margin="2,2,0,0" />
                                                                    <TextBlock VerticalAlignment="Center" Classes="header" Text="Actions" />
                                                                </StackPanel>
                                                            </ToggleButton>
                                                        </Border>

                                                        <ItemsControl
                                                            Grid.Row="1"
                                                            VerticalAlignment="Top"
                                                            ItemsSource="{Binding Inspector.Actions}">
                                                            <ItemsControl.IsVisible>
                                                                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                                                    <Binding Path="Inspector.HasActions" />
                                                                    <Binding Path="Inspector.ActionsSection.IsExpanded" />
                                                                </MultiBinding>
                                                            </ItemsControl.IsVisible>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:InspectorActionViewModel">
                                                                    <Button
                                                                        Padding="10,4"
                                                                        Margin="12,6,12,0"
                                                                        HorizontalAlignment="Stretch"
                                                                        VerticalAlignment="Center"
                                                                        Command="{Binding ExecuteActionCommand}"
                                                                        Content="{Binding Label}"
                                                                        IsEnabled="{Binding IsEnabled}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>

                                                    <!--  Scene Properties (shown when root node is selected)  -->
                                                    <Grid
                                                        Margin="0"
                                                        IsVisible="{Binding Inspector.HasSceneProperties}"
                                                        RowDefinitions="Auto, Auto">
                                                        <Border Grid.Row="0" Classes="panel-header">
                                                            <ToggleButton
                                                                Classes="section-toggle"
                                                                IsChecked="{Binding Inspector.ScenePropertiesSection.IsExpanded, Mode=TwoWay}">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <controls:Codicon Kind="{Binding Inspector.ScenePropertiesSection.ChevronKind}" Size="10" Margin="2,2,0,0" />
                                                                    <TextBlock VerticalAlignment="Center" Classes="header" Text="Scene Properties" />
                                                                </StackPanel>
                                                            </ToggleButton>
                                                        </Border>
                                                        <inspector:InspectorPropertyItemsControl
                                                            Grid.Row="1"
                                                            ItemsSource="{Binding Inspector.SceneProperties}">
                                                            <inspector:InspectorPropertyItemsControl.IsVisible>
                                                                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                                                    <Binding Path="Inspector.HasSceneProperties" />
                                                                    <Binding Path="Inspector.ScenePropertiesSection.IsExpanded" />
                                                                </MultiBinding>
                                                            </inspector:InspectorPropertyItemsControl.IsVisible>
                                                        </inspector:InspectorPropertyItemsControl>
                                                    </Grid>

                                                    <!--  Swatch Overrides (per-entity edit routing + copy)  -->
                                                    <Grid
                                                        Margin="0"
                                                        DataContext="{Binding Inspector}"
                                                        IsVisible="{Binding IsEntity}"
                                                        RowDefinitions="Auto, Auto">
                                                        <Border Grid.Row="0" Classes="panel-header">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <ToggleButton
                                                                    Grid.Column="0"
                                                                    Classes="section-toggle"
                                                                    IsChecked="{Binding SwatchOverridesSection.IsExpanded, Mode=TwoWay}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                        <controls:Codicon Kind="{Binding SwatchOverridesSection.ChevronKind}" Size="10" Margin="2,2,0,0" />
                                                                        <TextBlock VerticalAlignment="Center" Classes="header" Text="Swatch Overrides" />
                                                                    </StackPanel>
                                                                </ToggleButton>
                                                                <Border
                                                                    Grid.Column="1"
                                                                    Margin="6,0,4,0"
                                                                    Padding="6,1"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    Background="{DynamicResource Brush.AccentSubtle}"
                                                                    BorderBrush="{DynamicResource Brush.Accent}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="{DynamicResource Radius.Large}"
                                                                    IsVisible="{Binding HasOverriddenProperties}">
                                                                    <TextBlock
                                                                        FontSize="10"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{DynamicResource Brush.AccentHover}"
                                                                        Text="{Binding OverriddenPropertyCount}" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <StackPanel Grid.Row="1" Margin="12,8,12,10" Spacing="10" IsVisible="{Binding SwatchOverridesSection.IsExpanded}">
                                                            <StackPanel Spacing="4" IsVisible="{Binding HasOverriddenProperties}">
                                                                <TextBlock
                                                                    Classes="section-label"
                                                                    Text="{Binding OverriddenPropertiesHeader}"
                                                                    TextTrimming="CharacterEllipsis" />

                                                                <ItemsControl ItemsSource="{Binding OverriddenProperties}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:InspectorPropertyViewModelBase">
                                                                            <Grid Margin="0,1" ColumnDefinitions="Auto,*,Auto">
                                                                                <Border
                                                                                    Grid.Column="0"
                                                                                    Width="2"
                                                                                    Margin="0,1,7,1"
                                                                                    Background="{DynamicResource Brush.Accent}"
                                                                                    CornerRadius="1" />
                                                                                <TextBlock
                                                                                    Grid.Column="1"
                                                                                    FontSize="11"
                                                                                    VerticalAlignment="Center"
                                                                                    Text="{Binding Label}"
                                                                                    TextTrimming="CharacterEllipsis"
                                                                                    ToolTip.Tip="{Binding OverrideTooltip}" />
                                                                                <Button
                                                                                    Grid.Column="2"
                                                                                    Classes="reset-icon"
                                                                                    Command="{Binding RevertOverrideCommand}"
                                                                                    ToolTip.Tip="Revert to base value">
                                                                                    <Path
                                                                                        Width="11"
                                                                                        Height="11"
                                                                                        Stretch="Uniform"
                                                                                        Data="M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z" />
                                                                                </Button>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <Button
                                                                        Grid.Column="0"
                                                                        Padding="8,2"
                                                                        VerticalAlignment="Center"
                                                                        Content="Revert All"
                                                                        Command="{Binding ResetSwatchOverridesCommand}"
                                                                        ToolTip.Tip="Revert swatch-specific property overrides back to base values." />
                                                                </Grid>

                                                            </StackPanel>

                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="{DynamicResource Brush.TextFaint}"
                                                                IsVisible="{Binding ShowNoOverridesHint}"
                                                                Text="No properties overridden on this swatch."
                                                                TextWrapping="Wrap" />

                                                            <StackPanel Spacing="5">
                                                                <TextBlock Classes="section-label" Text="Copy properties from other swatch" />
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <ComboBox
                                                                        Grid.Column="0"
                                                                        Margin="0,0,6,0"
                                                                        HorizontalAlignment="Stretch"
                                                                        PlaceholderText="Select swatch"
                                                                        IsEnabled="{Binding HasCopySwatchSources}"
                                                                        ItemsSource="{Binding CopySwatchSources}"
                                                                        SelectedItem="{Binding SelectedCopySwatchSource, Mode=TwoWay}">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate x:DataType="vm:SwatchCopySourceOptionViewModel">
                                                                                <TextBlock Text="{Binding Name}" />
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                    <Button
                                                                        Grid.Column="1"
                                                                        Padding="8,2"
                                                                        Content="Apply"
                                                                        Command="{Binding ApplyCopyFromSwatchCommand}"
                                                                        ToolTip.Tip="Copy the selected source's property values onto the current edit target" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!--  Properties  -->
                                                    <Grid Margin="0" RowDefinitions="Auto, Auto, Auto">
                                                        <Border Grid.Row="0" Classes="panel-header">
                                                            <ToggleButton
                                                                Classes="section-toggle"
                                                                IsChecked="{Binding Inspector.PropertiesSection.IsExpanded, Mode=TwoWay}">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <controls:Codicon Kind="{Binding Inspector.PropertiesSection.ChevronKind}" Size="10" Margin="2,2,0,0" />
                                                                    <TextBlock VerticalAlignment="Center" Classes="header" Text="Properties" />
                                                                </StackPanel>
                                                            </ToggleButton>
                                                        </Border>
                                                        <inspector:InspectorPropertyItemsControl
                                                            Grid.Row="1"
                                                            ItemsSource="{Binding Inspector.Properties}"
                                                            IsVisible="{Binding Inspector.PropertiesSection.IsExpanded}" />
                                                    </Grid>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </ContentControl>
                                    </Tool>
                                </ToolDock>

                            </ProportionalDock>

                            <ProportionalDockSplitter x:Name="MainSplitter1" Id="MainSplitter1" />

                            <!--  Center column: Scene document + bottom panel (Assets/Console)  -->
                            <ProportionalDock x:Name="Center" Id="Center" Orientation="Vertical">

                                <DocumentDock x:Name="Documents" Id="Documents" CanCreateDocument="True" ActiveDockable="SceneDoc">
                                    <Document
                                        x:Name="SceneDoc"
                                        Id="Scene"
                                        Title="Viewport"
                                        CanDrag="False"
                                        CanFloat="False"
                                        CanPin="False"
                                        CanClose="False">
                                        <Grid>
                                            <Border
                                                x:Name="ViewportDropTarget"
                                                Background="{DynamicResource Brush.Background}"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="0">
                                                <local:EditorViewportControl
                                                    x:Name="EditorViewportControl"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch" />
                                            </Border>
                                        </Grid>
                                    </Document>
                                </DocumentDock>

                                <ProportionalDockSplitter x:Name="CenterSplitter" Id="CenterSplitter" />

                                <ProportionalDock x:Name="Bottom" Id="Bottom" Orientation="Horizontal" Proportion="0.3">

                                    <ToolDock x:Name="AssetsPane" Id="AssetsPane" Alignment="Left" ActiveDockable="AssetsTool">
                                        <Tool x:Name="AssetsTool" Id="ContentBrowser" Title="Assets">
                                            <ContentControl DataContext="{Binding Source={x:Static vm:MainWindowViewModel.Instance}}">
                                                <DockPanel>
                                                <Border Classes="panel-header" DockPanel.Dock="Top" Height="36">
                                                    <Grid VerticalAlignment="Center" ColumnDefinitions="*, Auto, Auto, Auto">
                                                        <TextBlock Grid.Column="0" Margin="6,0" VerticalAlignment="Center" Classes="header" FontSize="12" Text="Assets" />
                                                        <ComboBox Grid.Column="1" Margin="0,0,4,0" Padding="6,2" FontSize="11" VerticalAlignment="Center" ToolTip.Tip="Sort order" ItemsSource="{Binding ContentBrowser.SortModeLabels}" SelectedIndex="{Binding ContentBrowser.SortModeIndex, Mode=TwoWay}" />
                                                        <Button Grid.Column="2" Padding="8,2" VerticalAlignment="Center" Command="{Binding ContentBrowser.ImportCommand}" Content="Import" IsEnabled="{Binding !IsSimulating}" ToolTip.Tip="Import external content into the asset registry." />
                                                        <Button Grid.Column="3" Padding="8,2" VerticalAlignment="Center" Content="New..." IsEnabled="{Binding !IsSimulating}">
                                                            <Button.Flyout>
                                                                <MenuFlyout>
                                                                    <MenuItem Command="{Binding ContentBrowser.NewPhysicsShapeCommand}" Header="Physics Shape..." />
                                                                    <MenuItem Command="{Binding ContentBrowser.NewMaterialCommand}" Header="Material" />
                                                                    <MenuItem Command="{Binding ContentBrowser.NewScriptCommand}" Header="Script..." />
                                                                </MenuFlyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                                <Grid ColumnDefinitions="220, *">
                                                    <ListBox
                                                        Grid.Column="0"
                                                        ItemsSource="{Binding ContentBrowser.Buckets}"
                                                        SelectedItem="{Binding ContentBrowser.CurrentBucket, Mode=TwoWay}">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:AssetBucketViewModel">
                                                                <TextBlock Text="{Binding Name}" />
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <ListBox
                                                        x:Name="ContentBrowserAssetList"
                                                        Grid.Column="1"
                                                        ItemsSource="{Binding ContentBrowser.Assets}"
                                                        SelectedItem="{Binding ContentBrowser.SelectedAsset, Mode=TwoWay}"
                                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                        <ListBox.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ListBox.ItemsPanel>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:AssetObjectViewModel">
                                                                <Border
                                                                    Width="80"
                                                                    Height="80"
                                                                    Margin="4"
                                                                    Padding="4"
                                                                    Background="Transparent"
                                                                    CornerRadius="{DynamicResource Radius.Small}">
                                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                                                                        <controls:Codicon Kind="{Binding IconKind}" Size="28" Opacity="0.85" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.AccentHover}" />
                                                                        <TextBlock
                                                                            Text="{Binding DisplayName}"
                                                                            FontSize="10"
                                                                            HorizontalAlignment="Center"
                                                                            TextAlignment="Center"
                                                                            TextWrapping="Wrap"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            MaxWidth="72" />
                                                                    </StackPanel>
                                                                    <Border.ContextMenu>
                                                                        <ContextMenu Opened="OnAssetContextMenuOpened">
                                                                            <MenuItem
                                                                                Command="{Binding ContentBrowser.AddToSceneCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                                CommandParameter="{Binding}"
                                                                                Header="Add to Current Scene"
                                                                                IsVisible="{Binding CanAddToScene, Source={x:Static vm:MainWindowViewModel.Instance}}" />
                                                                            <Separator IsVisible="{Binding CanAddToScene, Source={x:Static vm:MainWindowViewModel.Instance}}" />
                                                                            <MenuItem
                                                                                Command="{Binding ContentBrowser.EditAssetCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                                CommandParameter="{Binding}"
                                                                                Header="_Edit"
                                                                                IsEnabled="{Binding !IsSimulating, Source={x:Static vm:MainWindowViewModel.Instance}}" />
                                                                            <Separator IsVisible="{Binding HasActions}" />
                                                                            <MenuItem Header="Actions" IsVisible="{Binding HasActions}" IsEnabled="{Binding !IsSimulating, Source={x:Static vm:MainWindowViewModel.Instance}}" ItemsSource="{Binding Actions}">
                                                                                <MenuItem.ItemTemplate>
                                                                                    <DataTemplate x:DataType="vm:InspectorActionViewModel">
                                                                                        <MenuItem Command="{Binding ExecuteActionCommand}" Header="{Binding Label}" IsEnabled="{Binding IsEnabled}" />
                                                                                    </DataTemplate>
                                                                                </MenuItem.ItemTemplate>
                                                                            </MenuItem>
                                                                            <Separator />
                                                                            <MenuItem
                                                                                Command="{Binding ContentBrowser.DeleteAssetCommand, Source={x:Static vm:MainWindowViewModel.Instance}}"
                                                                                CommandParameter="{Binding}"
                                                                                Header="_Delete"
                                                                                IsEnabled="{Binding !IsSimulating, Source={x:Static vm:MainWindowViewModel.Instance}}" />
                                                                        </ContextMenu>
                                                                    </Border.ContextMenu>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Grid>
                                                </DockPanel>
                                            </ContentControl>
                                        </Tool>
                                    </ToolDock>

                                    <ProportionalDockSplitter x:Name="BottomSplitter" Id="BottomSplitter" />

                                    <ToolDock x:Name="ConsolePane" Id="ConsolePane" Alignment="Right" ActiveDockable="ConsoleTool">
                                        <Tool x:Name="ConsoleTool" Id="Console" Title="Console">
                                            <local:ConsoleView />
                                        </Tool>
                                    </ToolDock>

                                </ProportionalDock>

                            </ProportionalDock>

                        </ProportionalDock>

                    </RootDock>

                </DockControl>

                <!--  Status Bar  -->
                <Border Grid.Row="1" Classes="status-bar">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock
                            Classes="status-hint"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            Text="{Binding StatusText}" />
                        <ItemsControl
                            Grid.Column="1"
                            ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TaskItemViewModel">
                                    <Border Classes="task-box">
                                        <StackPanel Spacing="3">
                                            <TextBlock
                                                Classes="task-title"
                                                Text="{Binding TaskName}" />
                                            <ProgressBar
                                                Width="80"
                                                Height="3"
                                                Maximum="1.0"
                                                Minimum="0"
                                                Value="{Binding Progress}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>

        <!--  Foreground task overlay  -->
        <views:ForegroundTaskOverlay DataContext="{Binding ForegroundTask}" />
    </Grid>
</Window>
