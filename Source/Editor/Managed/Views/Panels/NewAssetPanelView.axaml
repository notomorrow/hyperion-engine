<UserControl
    x:Class="Hyperion.Editor.Views.Panels.NewAssetPanelView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Hyperion.Editor.Controls;assembly=Hyperion.Editor"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inspector="clr-namespace:Hyperion.Editor.Views.Inspector;assembly=Hyperion.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Hyperion.Editor.ViewModels;assembly=Hyperion.Editor"
    x:DataType="vm:NewAssetPanelViewModel"
    mc:Ignorable="d">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.PanelAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Padding="20,6" Classes="Primary" Command="{Binding ConfirmCommand}" Content="Create" />
                <Button Padding="20,6" Command="{Binding CancelCommand}" Content="Cancel" />
            </StackPanel>
        </Border>

        <ScrollViewer Padding="4,0" Offset="{Binding ScrollOffset, Mode=TwoWay}">
            <StackPanel Margin="12,12,12,8" Spacing="12">
                <StackPanel Spacing="6">
                    <TextBlock Classes="section-label" Text="Type" />
                    <Button
                        x:Name="PART_ClassButton"
                        HorizontalAlignment="Stretch"
                        Classes="class-picker-button"
                        IsEnabled="{Binding HasClassChoice}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <controls:Codicon
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource Brush.AccentHover}"
                                Kind="SymbolClass"
                                Size="12" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="6,0"
                                VerticalAlignment="Center"
                                Text="{Binding SelectedClassName}"
                                TextTrimming="CharacterEllipsis" />
                            <controls:Codicon
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource Brush.TextMuted}"
                                IsVisible="{Binding HasClassChoice}"
                                Kind="ChevronDown"
                                Size="10" />
                        </Grid>
                    </Button>
                </StackPanel>

                <Separator />

                <inspector:InspectorPropertyItemsControl
                    IsVisible="{Binding AssetSubObject.HasProperties}"
                    ItemsSource="{Binding AssetSubObject.Properties}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
