<Window
    x:Class="Hyperion.Editor.Views.ProjectSettingsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inspector="clr-namespace:Hyperion.Editor.Views.Inspector;assembly=Hyperion.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Hyperion.Editor.ViewModels;assembly=Hyperion.Editor"
    x:CompileBindings="False"
    x:DataType="vm:ProjectSettingsViewModel"
    mc:Ignorable="d"
    Title="Project Settings"
    Icon="/Assets/Branding/hyperion-icon.ico"
    Width="620"
    Height="480"
    MinWidth="480"
    MinHeight="320"
    Background="{DynamicResource Brush.Background}">

    <DockPanel>
        <Border
            DockPanel.Dock="Bottom"
            Padding="12,8"
            Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <Button
                    Grid.Column="1"
                    Click="OnCloseClick"
                    Content="Close"
                    ToolTip.Tip="Close (Esc)" />
            </Grid>
        </Border>

        <ScrollViewer Padding="0">
            <StackPanel Margin="16,14" Spacing="14">
                <TextBlock
                    Classes="muted"
                    FontSize="11.5"
                    IsVisible="{Binding !HasProject}"
                    Text="No project is open." />

                <StackPanel IsVisible="{Binding HasProject}" Spacing="14">
                    <TextBlock Classes="section-label" Text="Game" />

                    <Border
                        Padding="14,8,12,10"
                        Background="{DynamicResource Brush.PanelRaised}"
                        BorderBrush="{DynamicResource Brush.BorderLight}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Medium}">
                        <inspector:InspectorPropertyItemsControl ItemsSource="{Binding Properties}" ShowDescriptions="True" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
